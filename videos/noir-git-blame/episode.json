  "dialogue": [
    {
      "id": "n1",
      "speaker": "narrator",
      "text": "[low, gravelly] Two a.m. Production was dead.",
      "at": 0.3
    },
    {
      "id": "r1",
      "speaker": "rayan",
      "text": "[panicked, out of breath] Somebody killed my login!",
      "gap": 0.5
    },
    {
      "id": "c1",
      "speaker": "claude",
      "text": "[low, gravelly, deadpan] Easy, kid. What changed?",
      "gap": 0.2
    },
    {
      "id": "r2",
      "speaker": "rayan",
      "text": "[defensive] Nothing! I swear!",
      "gap": 0.1
    },
    {
      "id": "n2",
      "speaker": "narrator",
      "text": "[low, gravelly] Something always changes.",
      "gap": 0.25
    },
    {
      "id": "n3",
      "speaker": "narrator",
      "text": "[low, gravelly] So I rounded up the usual suspects.",
      "gap": 0.3
    },
    {
      "id": "n4",
      "speaker": "narrator",
      "text": "[low, gravelly] The intern. Clean. Only ever touched the README.",
      "gap": 0.2
    },
    {
      "id": "n5",
      "speaker": "narrator",
      "text": "[low, gravelly] The cache. Couldn't remember a thing.",
      "gap": 0.3
    },
    {
      "id": "r3",
      "speaker": "rayan",
      "text": "[shouting] It's always DNS!",
      "gap": 0.2
    },
    {
      "id": "c2",
      "speaker": "claude",
      "text": "[low, gravelly] Not this time, kid. DNS had an alibi... it was still propagating.",
      "gap": 0.15
    },
    {
      "id": "n6",
      "speaker": "narrator",
      "text": "[low, gravelly] That left one place to look.",
      "gap": 0.35
    },
    {
      "id": "n7",
      "speaker": "narrator",
      "text": "[slowly, stunned] ...I knew that handwriting.",
      "gap": 1.4
    },
    {
      "id": "r4",
      "speaker": "rayan",
      "text": "[eager] Well? Who did it?",
      "gap": 0.45
    },
    {
      "id": "c3",
      "speaker": "claude",
      "text": "[flatly] ...DNS.",
      "gap": 1.05
    },
    {
      "id": "r5",
      "speaker": "rayan",
      "text": "[triumphant] I KNEW it! It's always DNS!",
      "gap": 0.2
    },
    {
      "id": "n8",
      "speaker": "narrator",
      "text": "[low, gravelly, satisfied] Case closed.",
      "gap": 1.75
    }
  ],
